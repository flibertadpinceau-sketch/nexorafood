---
import BaseLayout from '../layouts/BaseLayout.astro';

const articulos = [
  {
    slug: 'sistema-alimentario',
    imagen: '/images/articulo-sistema-alimentario.jpg',
    titulo: '¿El sistema alimentario está diseñado para encarecer la comida saludable?',
    categoria: 'Economía',
    fecha: '2024',
    descripcion: 'Un análisis de las estructuras económicas que determinan el precio de los alimentos y su impacto en el acceso a una dieta saludable.',
  },
  {
    slug: 'ia-y-cultivos',
    imagen: '/images/articulo-ia-cultivos.jpg',
    titulo: 'La IA ya decide qué cultivos sobreviven una sequía. Ahora quiere decidir qué comes tú.',
    categoria: 'Tecnología',
    fecha: '2024',
    descripcion: 'Cómo la inteligencia artificial está transformando la agricultura y comenzando a influir en nuestras decisiones alimentarias.',
  },
  {
    slug: 'cultura-y-comida',
    imagen: '/images/articulo-cultura-comida.jpg',
    titulo: 'Lo que comes dice más de tu cultura que tu idioma.',
    categoria: 'Cultura',
    fecha: '2024',
    descripcion: 'La alimentación como espejo de identidad cultural: por qué lo que está en tu plato revela más sobre tus raíces que las palabras que usas.',
  },
];

const destacado = articulos.find((a) => a.slug === 'ia-y-cultivos');
const otros = articulos.filter((a) => a.slug !== 'ia-y-cultivos');

const temas = [
  'Política alimentaria',
  'Innovación y tecnología alimentaria',
  'Nutrición y salud pública',
  'Cultura alimentaria y antropología',
  'Economía y mercados alimentarios',
  'Sostenibilidad y medio ambiente',
  'Tendencias y futuro de la alimentación',
];
---

<BaseLayout title="Inicio" lang="es" path="/">

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-tag">Ciencia · Economía · Cultura</p>
        <h1 class="hero-title">Detrás de tu plato hay ciencia, dinero y poder.</h1>
        <p class="hero-desc">NexoraFood analiza el sistema alimentario desde la ciencia, la economía y la cultura. Sin simplificaciones.</p>
        <div class="hero-actions">
          <a href="/#articulos" class="hero-btn">Leer artículos</a>
          <a href="#nosotros" class="hero-btn-outline">Sobre NexoraFood</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-photo">
          <img src="/images/hero-documental.jpg" alt="Fotografía documental de un agricultor en un campo de cultivo al atardecer" />
        </div>
      </div>
    </div>
  </section>

  <section class="quote-strip">
    <p>"Sistemas alimentarios y sociedad."</p>
  </section>

  {destacado && (
    <section id="articulos" class="featured-section">
      <div class="section-inner">
        <p class="eyebrow">Historia principal</p>
        <a href={`/articulos/${destacado.slug}`} class="featured-card">
          <div class="featured-media">
            <img src={destacado.imagen} alt="Vista aérea de un campo de cultivo en hileras" />
          </div>
          <div class="featured-content">
            <span class="card-categoria">{destacado.categoria}</span>
            <h2 class="featured-titulo">{destacado.titulo}</h2>
            <p class="card-desc">{destacado.descripcion}</p>
            <span class="card-leer">Leer artículo →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="articulos-section">
    <div class="section-inner">
      <h2 class="section-title">Más artículos</h2>
      <div class="articulos-grid">
        {otros.map((art) => (
          <a href={`/articulos/${art.slug}`} class="card">
            <div class="card-media">
              <img src={art.imagen} alt={art.titulo} />
            </div>
            <div class="card-body">
              <span class="card-categoria">{art.categoria}</span>
              <h3 class="card-titulo">{art.titulo}</h3>
              <p class="card-desc">{art.descripcion}</p>
              <span class="card-leer">Leer artículo →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="temas-section">
    <div class="section-inner">
      <p class="eyebrow eyebrow-light">Temas que cubrimos</p>
      <div class="temas-list">
        {temas.map((tema) => (
          <span class="tema-pill">{tema}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="nosotros" class="nosotros-section">
    <h2 class="nosotros-title">Sistemas alimentarios y sociedad</h2>
    <p class="nosotros-desc">NexoraFood es una plataforma editorial digital independiente enfocada en los sistemas alimentarios desde una perspectiva multidisciplinaria: un medio de análisis, divulgación e investigación donde la ciencia, la cultura, la economía, la tecnología y la sostenibilidad se cruzan con la alimentación.</p>
  </section>

  <section id="suscribir" class="newsletter-section">
    <div class="newsletter-inner">
      <div class="newsletter-text">
        <h3>Recibe nuestros análisis</h3>
        <p>Un correo, sin spam, cuando publicamos algo que vale la pena leer. Cuéntanos un poco de ti para ayudarnos a entender a nuestra audiencia — solo el nombre y el correo son obligatorios.</p>
      </div>
      <form class="newsletter-form" id="newsletter-form">
        <div class="hp-field" aria-hidden="true">
          <label for="sitio_web">Sitio web</label>
          <input type="text" id="sitio_web" name="sitio_web" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="nombre">Nombre *</label>
            <input id="nombre" name="nombre" type="text" required />
          </div>
          <div class="form-field">
            <label for="email-signup">Correo electrónico *</label>
            <input id="email-signup" name="email" type="email" required />
          </div>
        </div>
        <details class="form-more">
          <summary>Cuéntanos más sobre ti (opcional)</summary>
          <div class="form-more-fields">
            <div class="form-row">
              <div class="form-field">
                <label for="pais_origen">País de origen</label>
                <input id="pais_origen" name="pais_origen" type="text" placeholder="Opcional" />
              </div>
              <div class="form-field">
                <label for="pais_residencia">País de residencia</label>
                <input id="pais_residencia" name="pais_residencia" type="text" placeholder="Opcional" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="rango_edad">Rango de edad</label>
                <select id="rango_edad" name="rango_edad">
                  <option value="">Prefiero no decir</option>
                  <option value="18-24">18-24</option>
                  <option value="25-34">25-34</option>
                  <option value="35-44">35-44</option>
                  <option value="45-54">45-54</option>
                  <option value="55-64">55-64</option>
                  <option value="65+">65+</option>
                </select>
              </div>
              <div class="form-field">
                <label for="tipo_alimentacion">Tipo de alimentación</label>
                <select id="tipo_alimentacion" name="tipo_alimentacion">
                  <option value="">Prefiero no decir</option>
                  <option value="Omnívora">Omnívora</option>
                  <option value="Vegetariana">Vegetariana</option>
                  <option value="Vegana">Vegana</option>
                  <option value="Pescetariana">Pescetariana</option>
                  <option value="Otra">Otra</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field form-field-wide">
                <label for="practica_religiosa">¿Sigues alguna práctica alimentaria por motivos religiosos o culturales? (opcional)</label>
                <select id="practica_religiosa" name="practica_religiosa_cultural">
                  <option value="">Prefiero no decir</option>
                  <option value="Sí">Sí</option>
                  <option value="No">No</option>
                </select>
              </div>
              <div class="form-field">
                <label for="comida_favorita">Tu comida favorita</label>
                <input id="comida_favorita" name="comida_favorita" type="text" placeholder="Opcional" />
              </div>
            </div>
          </div>
        </details>
        <label class="consent-label">
          <input type="checkbox" id="consent" required />
          Acepto que NexoraFood use estos datos para conocer mejor a su audiencia. No se comparten con terceros.
        </label>
        <button type="submit">Suscribirme</button>
        <p class="form-message" id="form-message" role="status"></p>
      </form>
    </div>
  </section>

  <script>
    const SUPABASE_URL = 'https://epcjjdxjsxoztyromaip.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_L-wr7TlNHcjtn83Q0mtHlw_ekq8DiKv';

    const form = document.getElementById('newsletter-form');
    const message = document.getElementById('form-message');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      const data = new FormData(form);

      // Honeypot anti-spam: este campo esta oculto para personas, pero los
      // bots que autollenan formularios suelen rellenarlo igual.
      if (data.get('sitio_web')) {
        message.textContent = '¡Gracias por suscribirte!';
        message.classList.add('success');
        form.reset();
        return;
      }

      const payload = {
        nombre: data.get('nombre'),
        email: data.get('email'),
        pais_origen: data.get('pais_origen') || null,
        pais_residencia: data.get('pais_residencia') || null,
        rango_edad: data.get('rango_edad') || null,
        tipo_alimentacion: data.get('tipo_alimentacion') || null,
        practica_religiosa_cultural: data.get('practica_religiosa_cultural') || null,
        comida_favorita: data.get('comida_favorita') || null,
      };

      button.disabled = true;
      message.textContent = '';
      message.className = 'form-message';

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/suscriptores`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          message.textContent = '¡Gracias por suscribirte!';
          message.classList.add('success');
          form.reset();
        } else {
          let code = null;
          try {
            const err = await res.json();
            code = err?.code;
          } catch (_) {}
          if (res.status === 409 || code === '23505') {
            message.textContent = 'Este correo ya está suscrito.';
          } else {
            message.textContent = 'Hubo un error. Intenta de nuevo en un momento.';
          }
          message.classList.add('error');
        }
      } catch (err) {
        message.textContent = 'Hubo un error de conexión. Intenta de nuevo.';
        message.classList.add('error');
      } finally {
        button.disabled = false;
      }
    });
  </script>

  <section id="contacto" class="contacto-section">
    <p class="contacto-text">¿Tienes una historia, una colaboración o una pregunta?</p>
    <a href="mailto:contacto@nexorafood.com" class="contacto-link">contacto@nexorafood.com</a>
  </section>

</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  /* Hero */
  .hero {
    background-color: var(--color-header);
    padding: var(--space-24) var(--space-8) 0;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    align-items: center;
  }
  .hero-text {
    flex: 1 1 480px;
    min-width: 0;
    padding-bottom: var(--space-24);
  }
  .hero-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    color: var(--color-white);
    line-height: 1.12;
    margin-bottom: var(--space-6);
  }
  .hero-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-white);
    opacity: 0.82;
    max-width: 480px;
    margin-bottom: var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .hero-btn {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-white);
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: opacity 0.2s;
  }
  .hero-btn:hover { opacity: 0.85; }
  .hero-btn-outline {
    display: inline-block;
    border: 1px solid rgba(255,255,255,0.3);
    color: var(--color-white);
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 2px;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .hero-btn-outline:hover {
    opacity: 0.85;
    border-color: var(--color-accent);
  }
  .hero-media {
    flex: 1 1 420px;
    min-width: 0;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
  }
  .hero-photo {
    width: 100%;
    height: 420px;
    background-color: #0f1c0f;
    border-radius: 4px 4px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-photo span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  /* Quote strip */
  .quote-strip {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-8);
  }
  .quote-strip p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    color: var(--color-header);
    text-align: center;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  /* Featured */
  .featured-section {
    padding: var(--space-16) var(--space-8) 0;
  }
  .featured-card {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: stretch;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-16);
  }
  .featured-media {
    flex: 1 1 440px;
    min-width: 0;
    height: 320px;
    background-color: var(--color-border);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .featured-media span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8070;
  }
  .featured-content {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }
  .featured-titulo {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.25;
    color: var(--color-text);
  }

  /* Articulos grid */
  .articulos-section {
    padding: var(--space-16) var(--space-8);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }
  .articulos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card-media {
    height: 160px;
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-media span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8070;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
  }
  .card-categoria {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .card-titulo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    line-height: 1.3;
  }
  .card-desc {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    flex: 1;
  }
  .card-leer {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-top: var(--space-2);
  }

  /* Temas */
  .temas-section {
    background-color: var(--color-header);
    padding: var(--space-12) var(--space-8);
  }
  .temas-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .tema-pill {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-white);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 20px;
    padding: var(--space-2) var(--space-4);
  }

  /* Nosotros */
  .nosotros-section {
    padding: var(--space-16) var(--space-8);
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .nosotros-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .nosotros-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text-light);
  }

  /* Newsletter */
  .newsletter-section {
    background-color: var(--color-border);
    padding: var(--space-12) var(--space-8);
  }
  .newsletter-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .newsletter-text {
    text-align: center;
  }
  .newsletter-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .newsletter-text p {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field-wide {
    grid-column: 1 / -1;
  }
  .form-field label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }
  .form-field input,
  .form-field select {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background-color: var(--color-white);
    color: var(--color-text);
  }
  .form-more {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
  .form-more summary {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
  }
  .form-more summary::-webkit-details-marker {
    display: none;
  }
  .form-more summary::before {
    content: "+ ";
  }
  .form-more[open] summary::before {
    content: "− ";
  }
  .form-more-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }
  .consent-label input {
    margin-top: 3px;
  }
  .newsletter-form button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    background-color: var(--color-accent);
    border: none;
    padding: var(--space-4) var(--space-6);
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .newsletter-form button:hover {
    opacity: 0.88;
  }
  .newsletter-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .form-message {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    min-height: 1.2em;
  }
  .form-message.success {
