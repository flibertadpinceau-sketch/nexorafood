---
import BaseLayout from '../../layouts/BaseLayout.astro';

const articulos = [
  {
    slug: 'sistema-alimentario',
    imagen: '/images/articulo-sistema-alimentario.jpg',
    titulo: 'Is the Food System Designed to Make Healthy Food Expensive?',
    categoria: 'Economics',
    fecha: '2024',
    descripcion: 'An analysis of the economic structures that determine food prices and their impact on access to a healthy diet.',
  },
  {
    slug: 'ia-y-cultivos',
    imagen: '/images/articulo-ia-cultivos.jpg',
    titulo: 'AI Already Decides Which Crops Survive a Drought. Now It Wants to Decide What You Eat.',
    categoria: 'Technology',
    fecha: '2024',
    descripcion: 'How artificial intelligence is transforming agriculture and starting to influence our food choices.',
  },
  {
    slug: 'cultura-y-comida',
    imagen: '/images/articulo-cultura-comida.jpg',
    titulo: 'What You Eat Says More About Your Culture Than Your Language.',
    categoria: 'Culture',
    fecha: '2024',
    descripcion: "Food as a mirror of cultural identity: why what's on your plate reveals more about your roots than the words you use.",
  },
];

const destacado = articulos.find((a) => a.slug === 'ia-y-cultivos');
const otros = articulos.filter((a) => a.slug !== 'ia-y-cultivos');

const temas = [
  'Food policy',
  'Food innovation and technology',
  'Nutrition and public health',
  'Food culture and anthropology',
  'Food economics and markets',
  'Sustainability and the environment',
  'Trends and the future of food',
];
---

<BaseLayout title="Home" lang="en" path="/">

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-tag">Science · Economics · Culture</p>
        <h1 class="hero-title">Behind your plate, there's science, money and power.</h1>
        <p class="hero-desc">NexoraFood examines the food system through science, economics and culture. No oversimplifications.</p>
        <div class="hero-actions">
          <a href="/en/#articulos" class="hero-btn">Read articles</a>
          <a href="#nosotros" class="hero-btn-outline">About NexoraFood</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="hero-photo">
          <img src="/images/hero-documental.jpg" alt="Documentary photograph of a farmer in a field at sunset" />
        </div>
      </div>
    </div>
  </section>

  <section class="quote-strip">
    <p>"Food systems and society."</p>
  </section>

  {destacado && (
    <section id="articulos" class="featured-section">
      <div class="section-inner">
        <p class="eyebrow">Top story</p>
        <a href={`/en/articulos/${destacado.slug}`} class="featured-card">
          <div class="featured-media">
            <img src={destacado.imagen} alt="Aerial view of a crop field in rows" />
          </div>
          <div class="featured-content">
            <span class="card-categoria">{destacado.categoria}</span>
            <h2 class="featured-titulo">{destacado.titulo}</h2>
            <p class="card-desc">{destacado.descripcion}</p>
            <span class="card-leer">Read article →</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="articulos-section">
    <div class="section-inner">
      <h2 class="section-title">More articles</h2>
      <div class="articulos-grid">
        {otros.map((art) => (
          <a href={`/en/articulos/${art.slug}`} class="card">
            <div class="card-media">
              <img src={art.imagen} alt={art.titulo} />
            </div>
            <div class="card-body">
              <span class="card-categoria">{art.categoria}</span>
              <h3 class="card-titulo">{art.titulo}</h3>
              <p class="card-desc">{art.descripcion}</p>
              <span class="card-leer">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="temas-section">
    <div class="section-inner">
      <p class="eyebrow eyebrow-light">Topics we cover</p>
      <div class="temas-list">
        {temas.map((tema) => (
          <span class="tema-pill">{tema}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="nosotros" class="nosotros-section">
    <h2 class="nosotros-title">Food systems and society</h2>
    <p class="nosotros-desc">NexoraFood is an independent digital editorial platform focused on food systems from a multidisciplinary perspective: an outlet for analysis, journalism and research where science, culture, economics, technology and sustainability intersect with food.</p>
  </section>

  <section id="suscribir" class="newsletter-section">
    <div class="newsletter-inner">
      <div class="newsletter-text">
        <h3>Get our analysis</h3>
        <p>One email, no spam, whenever we publish something worth reading. Tell us a little about yourself to help us understand our audience — only your name and email are required.</p>
      </div>
      <form class="newsletter-form" id="newsletter-form">
        <div class="form-row">
          <div class="form-field">
            <label for="nombre">Name *</label>
            <input id="nombre" name="nombre" type="text" required />
          </div>
          <div class="form-field">
            <label for="email-signup">Email *</label>
            <input id="email-signup" name="email" type="email" required />
          </div>
        </div>
        <details class="form-more">
          <summary>Tell us more about yourself (optional)</summary>
          <div class="form-more-fields">
            <div class="form-row">
              <div class="form-field">
                <label for="pais_origen">Country of origin</label>
                <input id="pais_origen" name="pais_origen" type="text" placeholder="Optional" />
              </div>
              <div class="form-field">
                <label for="pais_residencia">Country of residence</label>
                <input id="pais_residencia" name="pais_residencia" type="text" placeholder="Optional" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="rango_edad">Age range</label>
                <select id="rango_edad" name="rango_edad">
                  <option value="">Prefer not to say</option>
                  <option value="18-24">18-24</option>
                  <option value="25-34">25-34</option>
                  <option value="35-44">35-44</option>
                  <option value="45-54">45-54</option>
                  <option value="55-64">55-64</option>
                  <option value="65+">65+</option>
                </select>
              </div>
              <div class="form-field">
                <label for="tipo_alimentacion">Diet type</label>
                <select id="tipo_alimentacion" name="tipo_alimentacion">
                  <option value="">Prefer not to say</option>
                  <option value="Omnívora">Omnivore</option>
                  <option value="Vegetariana">Vegetarian</option>
                  <option value="Vegana">Vegan</option>
                  <option value="Pescetariana">Pescatarian</option>
                  <option value="Otra">Other</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field form-field-wide">
                <label for="practica_religiosa">Do you follow any dietary practice for religious or cultural reasons? (optional)</label>
                <select id="practica_religiosa" name="practica_religiosa_cultural">
                  <option value="">Prefer not to say</option>
                  <option value="Sí">Yes</option>
                  <option value="No">No</option>
                </select>
              </div>
              <div class="form-field">
                <label for="comida_favorita">Your favorite food</label>
                <input id="comida_favorita" name="comida_favorita" type="text" placeholder="Optional" />
              </div>
            </div>
          </div>
        </details>
        <label class="consent-label">
          <input type="checkbox" id="consent" required />
          I agree that NexoraFood may use this data to better understand its audience. It is not shared with third parties.
        </label>
        <button type="submit">Subscribe</button>
        <p class="form-message" id="form-message" role="status"></p>
      </form>
    </div>
  </section>

  <script>
    const SUPABASE_URL = 'https://epcjjdxjsxoztyromaip.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_L-wr7TlNHcjtn83Q0mtHlw_ekq8DiKv';

    const form = document.getElementById('newsletter-form');
    const message = document.getElementById('form-message');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      const data = new FormData(form);
      const payload = {
        nombre: data.get('nombre'),
        email: data.get('email'),
        pais_origen: data.get('pais_origen') || null,
        pais_residencia: data.get('pais_residencia') || null,
        rango_edad: data.get('rango_edad') || null,
        tipo_alimentacion: data.get('tipo_alimentacion') || null,
        practica_religiosa_cultural: data.get('practica_religiosa_cultural') || null,
        comida_favorita: data.get('comida_favorita') || null,
      };

      button.disabled = true;
      message.textContent = '';
      message.className = 'form-message';

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/suscriptores`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          message.textContent = 'Thanks for subscribing!';
          message.classList.add('success');
          form.reset();
        } else {
          let code = null;
          try {
            const err = await res.json();
            code = err?.code;
          } catch (_) {}
          if (res.status === 409 || code === '23505') {
            message.textContent = 'This email is already subscribed.';
          } else {
            message.textContent = 'Something went wrong. Please try again in a moment.';
          }
          message.classList.add('error');
        }
      } catch (err) {
        message.textContent = 'There was a connection error. Please try again.';
        message.classList.add('error');
      } finally {
        button.disabled = false;
      }
    });
  </script>

  <section id="contacto" class="contacto-section">
    <p class="contacto-text">Have a story, a collaboration, or a question?</p>
    <a href="mailto:contacto@nexorafood.com" class="contacto-link">contacto@nexorafood.com</a>
  </section>

</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  /* Hero */
  .hero {
    background-color: var(--color-header);
    padding: var(--space-24) var(--space-8) 0;
  }
  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    align-items: center;
  }
  .hero-text {
    flex: 1 1 480px;
    min-width: 0;
    padding-bottom: var(--space-24);
  }
  .hero-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    color: var(--color-white);
    line-height: 1.12;
    margin-bottom: var(--space-6);
  }
  .hero-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-white);
    opacity: 0.82;
    max-width: 480px;
    margin-bottom: var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .hero-btn {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-white);
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: opacity 0.2s;
  }
  .hero-btn:hover { opacity: 0.85; }
  .hero-btn-outline {
    display: inline-block;
    border: 1px solid rgba(255,255,255,0.3);
    color: var(--color-white);
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 2px;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .hero-btn-outline:hover {
    opacity: 0.85;
    border-color: var(--color-accent);
  }
  .hero-media {
    flex: 1 1 420px;
    min-width: 0;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
  }
  .hero-photo {
    width: 100%;
    height: 420px;
    background-color: #0f1c0f;
    border-radius: 4px 4px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-photo span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  /* Quote strip */
  .quote-strip {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-8);
  }
  .quote-strip p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    color: var(--color-header);
    text-align: center;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  /* Featured */
  .featured-section {
    padding: var(--space-16) var(--space-8) 0;
  }
  .featured-card {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: stretch;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-16);
  }
  .featured-media {
    flex: 1 1 440px;
    min-width: 0;
    height: 320px;
    background-color: var(--color-border);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .featured-media span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8070;
  }
  .featured-content {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }
  .featured-titulo {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    line-height: 1.25;
    color: var(--color-text);
  }

  /* Articulos grid */
  .articulos-section {
    padding: var(--space-16) var(--space-8);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }
  .articulos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .card-media {
    height: 160px;
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-media span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8070;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
  }
  .card-categoria {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .card-titulo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    line-height: 1.3;
  }
  .card-desc {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    flex: 1;
  }
  .card-leer {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-top: var(--space-2);
  }

  /* Temas */
  .temas-section {
    background-color: var(--color-header);
    padding: var(--space-12) var(--space-8);
  }
  .temas-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .tema-pill {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-white);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 20px;
    padding: var(--space-2) var(--space-4);
  }

  /* Nosotros */
  .nosotros-section {
    padding: var(--space-16) var(--space-8);
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .nosotros-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .nosotros-desc {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text-light);
  }

  /* Newsletter */
  .newsletter-section {
    background-color: var(--color-border);
    padding: var(--space-12) var(--space-8);
  }
  .newsletter-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .newsletter-text {
    text-align: center;
  }
  .newsletter-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .newsletter-text p {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-field-wide {
    grid-column: 1 / -1;
  }
  .form-field label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }
  .form-field input,
  .form-field select {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background-color: var(--color-white);
    color: var(--color-text);
  }
  .form-more {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
  .form-more summary {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
  }
  .form-more summary::-webkit-details-marker {
    display: none;
  }
  .form-more summary::before {
    content: "+ ";
  }
  .form-more[open] summary::before {
    content: "− ";
  }
  .form-more-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }
  .consent-label input {
    margin-top: 3px;
  }
  .newsletter-form button {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    background-color: var(--color-accent);
    border: none;
    padding: var(--space-4) var(--space-6);
    border-radius: 2px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .newsletter-form button:hover {
    opacity: 0.88;
  }
  .newsletter-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .form-message {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    min-height: 1.2em;
  }
  .form-message.success {
    color: var(--color-accent);
  }
  .form-message.error {
    color: var(--color-amber);
  }
  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .form-field-wide {
      grid-column: auto;
    }
  }

  /* Contacto */
  .contacto-section {
    padding: var(--space-16) var(--space-8);
    text-align: center;
  }
  .contacto-text {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-light);
    margin-bottom: var(--space-3);
  }
  .contacto-link {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
  }
  .contacto-link:hover {
    opacity: 0.8;
  }

  .hero-photo img,
  .featured-media img,
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
