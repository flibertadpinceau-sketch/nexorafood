---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en' | 'fr';
  path?: string;
}

const { title, description, lang = 'es', path = '/' } = Astro.props;

const prefixes: Record<string, string> = { es: '', en: '/en', fr: '/fr' };

const defaultDescriptions: Record<string, string> = {
  es: 'Ciencia, economía y cultura en cada bocado.',
  en: 'Science, economics and culture in every bite.',
  fr: 'Science, économie et culture à chaque bouchée.',
};
const finalDescription = description ?? defaultDescriptions[lang];

const navLabels: Record<string, { inicio: string; articulos: string; nosotros: string; suscribir: string }> = {
  es: { inicio: 'Inicio', articulos: 'Artículos', nosotros: 'Sobre nosotros', suscribir: 'Suscribirse' },
  en: { inicio: 'Home', articulos: 'Articles', nosotros: 'About', suscribir: 'Subscribe' },
  fr: { inicio: 'Accueil', articulos: 'Articles', nosotros: 'À propos', suscribir: "S'abonner" },
};
const nav = navLabels[lang];

const footerTexts: Record<string, string> = {
  es: '© 2026 NexoraFood — Sistemas alimentarios y sociedad.',
  en: '© 2026 NexoraFood — Food systems and society.',
  fr: '© 2026 NexoraFood — Systèmes alimentaires et société.',
};

const home = `${prefixes[lang]}/`;
const langUrl = (l: 'es' | 'en' | 'fr') => `${prefixes[l]}${path}`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={finalDescription} />
    <title>{title} | NexoraFood</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body>

    <div class="lang-bar">
      <div class="lang-bar-inner" role="group" aria-label="Seleccionar idioma / Select language / Choisir la langue">
        <a href={langUrl('es')} class={`lang-btn ${lang === 'es' ? 'is-active' : ''}`} aria-pressed={lang === 'es'}>ES</a>
        <span class="lang-sep" aria-hidden="true">|</span>
        <a href={langUrl('en')} class={`lang-btn ${lang === 'en' ? 'is-active' : ''}`} aria-pressed={lang === 'en'}>EN</a>
        <span class="lang-sep" aria-hidden="true">|</span>
        <a href={langUrl('fr')} class={`lang-btn ${lang === 'fr' ? 'is-active' : ''}`} aria-pressed={lang === 'fr'}>FR</a>
      </div>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href={home} class="logo">
          <svg class="logo-icon" viewBox="0 0 128 128" aria-hidden="true" focusable="false">
            <g><polygon points="41.00,54.08 35.25,64.04 23.75,64.04 18.00,54.08 23.75,44.12 35.25,44.12" fill="#a8311f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="41.00,74.00 35.25,83.96 23.75,83.96 18.00,74.00 23.75,64.04 35.25,64.04" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="41.00,93.92 35.25,103.88 23.75,103.88 18.00,93.92 23.75,83.96 35.25,83.96" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="58.25,64.04 52.50,74.00 41.00,74.00 35.25,64.04 41.00,54.08 52.50,54.08" fill="#a8311f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="58.25,83.96 52.50,93.92 41.00,93.92 35.25,83.96 41.00,74.00 52.50,74.00" fill="#c6472c" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="58.25,103.88 52.50,113.84 41.00,113.84 35.25,103.88 41.00,93.92 52.50,93.92" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="75.50,74.00 69.75,83.96 58.25,83.96 52.50,74.00 58.25,64.04 69.75,64.04" fill="#d2572f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="75.50,93.92 69.75,103.88 58.25,103.88 52.50,93.92 58.25,83.96 69.75,83.96" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="92.75,64.04 87.00,74.00 75.50,74.00 69.75,64.04 75.50,54.08 87.00,54.08" fill="#8f2619" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="92.75,83.96 87.00,93.92 75.50,93.92 69.75,83.96 75.50,74.00 87.00,74.00" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="92.75,103.88 87.00,113.84 75.50,113.84 69.75,103.88 75.50,93.92 87.00,93.92" fill="#8f2619" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="110.00,54.08 104.25,64.04 92.75,64.04 87.00,54.08 92.75,44.12 104.25,44.12" fill="#d2572f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="110.00,74.00 104.25,83.96 92.75,83.96 87.00,74.00 92.75,64.04 104.25,64.04" fill="#c6472c" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="110.00,93.92 104.25,103.88 92.75,103.88 87.00,93.92 92.75,83.96 104.25,83.96" fill="#b33822" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/></g>
            <g><polygon points="58.25,44.12 52.50,54.08 41.00,54.08 35.25,44.12 41.00,34.16 52.50,34.16" fill="#6fa23f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="92.75,44.12 87.00,54.08 75.50,54.08 69.75,44.12 75.50,34.16 87.00,34.16" fill="#5c8a35" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/><polygon points="75.50,54.08 69.75,64.04 58.25,64.04 52.50,54.08 58.25,44.12 69.75,44.12" fill="#86c24f" stroke="#f5f0e8" stroke-width="1.8" stroke-linejoin="round"/></g>
            <path d="M 64 36 C 53 28, 49 14, 61 9 C 71 5, 82 9, 76 19" fill="none" stroke="#3f5d24" stroke-width="4.2" stroke-linecap="round"/>
          </svg>
          <span class="logo-text">NexoraFood</span>
        </a>
        <nav class="main-nav">
          <a href={home}>{nav.inicio}</a>
          <a href={`${home}#articulos`}>{nav.articulos}</a>
          <a href={`${home}#nosotros`}>{nav.nosotros}</a>
        </nav>
        <a href={`${home}#suscribir`} class="nav-cta">{nav.suscribir}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>{footerTexts[lang]}</p>
      </div>
    </footer>

  </body>
</html>

<style>
  .lang-bar {
    background-color: #132213;
  }
  .lang-bar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-8);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
  }
  .lang-btn {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.6);
    background: none;
    border: none;
    padding: 6px 2px;
    cursor: pointer;
  }
  .lang-btn.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }
  .lang-btn:hover {
    opacity: 0.85;
  }
  .lang-sep {
    color: rgba(255,255,255,0.25);
    font-size: var(--text-xs);
  }

  .site-header {
    background-color: var(--color-header);
    padding: var(--space-4) var(--space-8);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .logo-icon {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.02em;
  }

  .logo-text span {
    color: var(--color-accent);
  }

  .main-nav {
    display: flex;
    gap: var(--space-8);
  }

  .main-nav a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-white);
    opacity: 0.85;
    transition: opacity 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .main-nav a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .nav-cta {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-header);
    background-color: var(--color-accent);
    padding: var(--space-3) var(--space-6);
    border-radius: 2px;
    white-space: nowrap;
  }
  .nav-cta:hover {
    opacity: 0.88;
  }

  .site-footer {
    background-color: var(--color-header);
    padding: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
    color: var(--color-white);
    opacity: 0.7;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }
</style>
