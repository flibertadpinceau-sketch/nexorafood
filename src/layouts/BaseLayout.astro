---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ciencia, economía y cultura en cada bocado.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | NexoraFood</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>

    <div class="lang-bar">
      <div class="lang-bar-inner" role="group" aria-label="Seleccionar idioma">
        <button type="button" class="lang-btn is-active" aria-pressed="true">ES</button>
        <span class="lang-sep" aria-hidden="true">|</span>
        <button type="button" class="lang-btn" aria-pressed="false">EN</button>
        <span class="lang-sep" aria-hidden="true">|</span>
        <button type="button" class="lang-btn" aria-pressed="false">FR</button>
      </div>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">NexoraFood</a>
        <nav class="main-nav">
          <a href="/">Inicio</a>
          <a href="/articulos">Artículos</a>
          <a href="/#nosotros">Sobre nosotros</a>
        </nav>
        <a href="/#suscribir" class="nav-cta">Suscribirse</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>© 2026 NexoraFood — Sistemas alimentarios y sociedad.</p>
      </div>
    </footer>

  </body>
</html>

<style>
  .lang-bar {
    background-color: #132213;
  }
  .lang-bar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-8);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
  }
  .lang-btn {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.6);
    background: none;
    border: none;
    padding: 6px 2px;
    cursor: pointer;
  }
  .lang-btn.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }
  .lang-btn:hover {
    opacity: 0.85;
  }
  .lang-sep {
    color: rgba(255,255,255,0.25);
    font-size: var(--text-xs);
  }

  .site-header {
    background-color: var(--color-header);
    padding: var(--space-4) var(--space-8);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.02em;
  }

  .logo span {
    color: var(--color-accent);
  }

  .main-nav {
    display: flex;
    gap: var(--space-8);
  }

  .main-nav a {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-white);
    opacity: 0.85;
    transition: opacity 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .main-nav a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .nav-cta {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-header);
    background-color: var(--color-accent);
    padding: var(--space-3) var(--space-6);
    border-radius: 2px;
    white-space: nowrap;
  }
  .nav-cta:hover {
    opacity: 0.88;
  }

  .site-footer {
    background-color: var(--color-header);
    padding: var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    text-align: center;
    color: var(--color-white);
    opacity: 0.7;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }
</style>
